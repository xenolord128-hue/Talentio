# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Authorized administrator email for the secure Admin Panel.
ADMIN_EMAIL="lord79915@gmail.com"

# Google reCAPTCHA v2 Configuration
# Public Site Key for the "I'm not a robot" checkbox
VITE_RECAPTCHA_SITE_KEY="6LfVxsotAAAAAJMmf30447ftSbru23EJOZhNqUJb"

# Server-Side Secret Key (ONLY kept in server environment variables or Netlify environment variables)
# NEVER expose this secret in client-side code, frontend bundles, or public repositories.
RECAPTCHA_SECRET_KEY="YOUR_RECAPTCHA_SECRET_KEY_HERE"

