<script>

/* =========================
   SEND MESSAGE
========================= */

const input =
    document.getElementById("messageInput");

const messages =
    document.getElementById("messages");


function escapeHTML(text){

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;
}


function sendMessage(){

    const text =
        input.value.trim();

    if(!text) return;


    const row =
        document.createElement("div");

    row.className =
        "message-row sent";


    row.innerHTML = `

        <div class="message">

            ${escapeHTML(text)}

            <span class="meta">

                Now

                <span class="checks">
                    ✓
                </span>

            </span>

        </div>

    `;


    messages.appendChild(row);

    input.value = "";

    messages.scrollTop =
        messages.scrollHeight;
}


input.addEventListener(
    "keydown",
    function(e){

        if(e.key === "Enter"){
            sendMessage();
        }

    }
);


/* =========================
   OPEN CHAT
========================= */

function openChat(
    element,
    name,
    status,
    initials,
    avatarClass
){

    document
        .querySelectorAll(".chat")
        .forEach(chat =>
            chat.classList.remove("active")
        );


    element.classList.add("active");


    document
        .getElementById("profileName")
        .textContent = name;


    document
        .getElementById("profileStatus")
        .textContent = status;


    const avatar =
        document.getElementById("profileAvatar");

    avatar.className =
        "profile-avatar " + avatarClass;

    avatar.textContent =
        initials;


    messages.innerHTML = `

        <div class="date">
            TODAY
        </div>

        <div class="message-row received">

            <div class="message">

                Hey! How are you doing?

                <span class="meta">
                    12:15 PM
                </span>

            </div>

        </div>

        <div class="message-row sent">

            <div class="message">

                I'm doing great! How about you?

                <span class="meta">
                    12:17 PM
                    <span class="checks">
                        ✓✓
                    </span>
                </span>

            </div>

        </div>

        <div class="message-row received">

            <div class="message">

                Everything is good here. What are you working on?

                <span class="meta">
                    12:20 PM
                </span>

            </div>

        </div>

    `;


    messages.scrollTop =
        messages.scrollHeight;


    if(window.innerWidth <= 700){

        document
            .getElementById("sidebar")
            .classList.add("mobile-hidden");

        document
            .getElementById("main")
            .classList.add("mobile-visible");

    }

}


/* =========================
   ATTACHMENT
========================= */

function toggleAttachment(){

    document
        .getElementById("attachMenu")
        .classList.toggle("show");

}


/* =========================
   SEARCH
========================= */

document
    .getElementById("search")
    .addEventListener(
        "input",
        function(){

            const query =
                this.value.toLowerCase();


            document
                .querySelectorAll(".chat")
                .forEach(chat => {

                    const name =
                        chat.dataset.name
                            .toLowerCase();


                    chat.style.display =
                        name.includes(query)
                            ? "flex"
                            : "none";

                });

        }
    );


/* =========================
   FILTERS
========================= */

document
    .querySelectorAll(".filter")
    .forEach(button => {

        button.addEventListener(
            "click",
            function(){

                document
                    .querySelectorAll(".filter")
                    .forEach(item =>
                        item.classList.remove("active")
                    );

                this.classList.add("active");

            }
        );

    });


/* =========================
   MOBILE BACK
========================= */

function showSidebar(){

    document
        .getElementById("sidebar")
        .classList.remove("mobile-hidden");


    document
        .getElementById("main")
        .classList.remove("mobile-visible");

}

</script>

</body>
</html>