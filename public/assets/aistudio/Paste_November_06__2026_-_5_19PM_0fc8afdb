<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Talentio — Messages</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#0d0920;
    --deep:#090616;
    --panel:#130e2c;
    --surface:#1a1633;

    --primary:#3d2fd1;
    --accent:#6e5bff;
    --lavender:#a38bff;

    --text:#f2f0ff;
    --muted:#918ba9;
    --muted2:#68627e;

    --incoming:#211b3c;
    --outgoing:#3d2fd1;

    --border:rgba(163,139,255,.11);
}

/* =========================
   GLOBAL
========================= */

html,
body{
    width:100%;
    height:100%;
}

body{
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(110,91,255,.12),
            transparent 32%
        ),
        var(--bg);

    color:var(--text);

    overflow:hidden;
}

/* Ambient lighting */

body::before{
    content:"";

    position:fixed;
    width:500px;
    height:500px;

    top:-250px;
    right:10%;

    background:
        radial-gradient(
            circle,
            rgba(110,91,255,.12),
            transparent 68%
        );

    filter:blur(30px);

    pointer-events:none;
}

button,
input{
    font-family:inherit;
}

/* =========================
   APP
========================= */

.app{
    width:100%;
    height:100vh;

    display:flex;

    padding:18px;

    gap:14px;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.008),
            transparent
        );
}

/* =========================
   SIDEBAR
========================= */

.sidebar{
    width:365px;
    min-width:365px;

    display:flex;
    flex-direction:column;

    background:
        linear-gradient(
            160deg,
            rgba(26,22,51,.94),
            rgba(13,9,32,.97)
        );

    border:1px solid var(--border);

    border-radius:24px;

    overflow:hidden;

    box-shadow:
        0 25px 100px rgba(0,0,0,.28);

    backdrop-filter:blur(30px);
}

/* =========================
   BRAND
========================= */

.sidebar-header{
    height:76px;

    padding:0 20px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    border-bottom:
        1px solid rgba(163,139,255,.07);
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.brand-icon{
    width:38px;
    height:38px;

    border-radius:13px;

    display:grid;
    place-items:center;

    font-size:13px;
    font-weight:900;

    color:white;

    background:
        linear-gradient(
            135deg,
            #3d2fd1 0%,
            #6e5bff 60%,
            #a38bff 100%
        );

    box-shadow:
        0 10px 35px rgba(110,91,255,.32);
}

.brand-text{
    font-size:16px;
    font-weight:800;

    letter-spacing:-.4px;
}

.brand-text span{
    color:var(--lavender);
}

/* =========================
   ICON
========================= */

.icon{
    width:38px;
    height:38px;

    border:1px solid rgba(163,139,255,.07);

    border-radius:12px;

    background:
        rgba(255,255,255,.025);

    color:#aaa4bd;

    display:grid;
    place-items:center;

    cursor:pointer;

    transition:
        transform .25s ease,
        background .25s ease,
        color .25s ease;
}

.icon:hover{
    color:white;

    background:
        rgba(110,91,255,.11);

    transform:translateY(-1px);
}

.header-actions{
    display:flex;
    gap:7px;
}

/* =========================
   SEARCH
========================= */

.search-wrapper{
    padding:17px 17px 11px;
}

.search{
    height:45px;

    display:flex;
    align-items:center;

    gap:10px;

    padding:0 14px;

    border-radius:14px;

    background:
        rgba(255,255,255,.028);

    border:
        1px solid rgba(163,139,255,.08);

    transition:.25s ease;
}

.search:focus-within{
    border-color:
        rgba(110,91,255,.4);

    box-shadow:
        0 0 0 4px rgba(110,91,255,.055);
}

.search-icon{
    color:#716b88;
    font-size:16px;
}

.search input{
    width:100%;

    border:0;
    outline:0;

    background:transparent;

    color:white;

    font-size:11px;
}

.search input::placeholder{
    color:#6e6882;
}

/* =========================
   FILTERS
========================= */

.filters{
    display:flex;
    gap:7px;

    padding:
        2px 17px 14px;
}

.filter{
    border:1px solid rgba(163,139,255,.08);

    background:transparent;

    color:#807a96;

    padding:7px 13px;

    border-radius:999px;

    font-size:9px;
    font-weight:700;

    cursor:pointer;

    transition:.2s;
}

.filter:hover{
    color:#b8b0d0;
}

.filter.active{
    color:#e8e4ff;

    background:
        linear-gradient(
            135deg,
            rgba(61,47,209,.35),
            rgba(110,91,255,.16)
        );

    border-color:
        rgba(110,91,255,.35);

    box-shadow:
        inset 0 0 15px rgba(110,91,255,.05);
}

/* =========================
   CHAT LIST
========================= */

.chat-list{
    flex:1;

    overflow-y:auto;

    padding:3px 7px 12px;
}

.chat-list::-webkit-scrollbar{
    width:4px;
}

.chat-list::-webkit-scrollbar-thumb{
    background:#241d45;
    border-radius:20px;
}

.chat{
    height:78px;

    padding:10px 11px;

    display:flex;
    align-items:center;

    gap:12px;

    border-radius:15px;

    cursor:pointer;

    border:1px solid transparent;

    transition:
        background .2s ease,
        border .2s ease,
        transform .2s ease;
}

.chat:hover{
    background:
        rgba(110,91,255,.045);
}

.chat.active{
    background:
        linear-gradient(
            100deg,
            rgba(110,91,255,.13),
            rgba(110,91,255,.035)
        );

    border-color:
        rgba(110,91,255,.12);
}

/* Avatar */

.avatar{
    width:47px;
    height:47px;

    flex-shrink:0;

    border-radius:50%;

    display:grid;
    place-items:center;

    position:relative;

    color:white;

    font-size:11px;
    font-weight:850;

    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.1);
}

.avatar.a1{
    background:
        linear-gradient(135deg,#4032d5,#9a87ff);
}

.avatar.a2{
    background:
        linear-gradient(135deg,#6740c9,#c29cff);
}

.avatar.a3{
    background:
        linear-gradient(135deg,#4055bc,#8da3ff);
}

.avatar.a4{
    background:
        linear-gradient(135deg,#633db1,#d49dff);
}

.avatar.a5{
    background:
        linear-gradient(135deg,#3739a1,#8b8df0);
}

.avatar.a6{
    background:
        linear-gradient(135deg,#49329d,#a38bff);
}

.online{
    position:absolute;

    width:10px;
    height:10px;

    right:-1px;
    bottom:1px;

    border-radius:50%;

    background:#61e6ad;

    border:2px solid #17112f;

    box-shadow:
        0 0 10px rgba(97,230,173,.45);
}

.chat-info{
    flex:1;
    min-width:0;
}

.chat-top{
    display:flex;
    justify-content:space-between;

    gap:8px;

    margin-bottom:5px;
}

.name{
    font-size:11.5px;
    font-weight:750;

    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.time{
    color:#69627f;
    font-size:8.5px;
}

.chat-bottom{
    display:flex;
    align-items:center;
    gap:8px;
}

.preview{
    flex:1;

    color:#7f7897;

    font-size:9.8px;

    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.preview.read{
    color:#9c95b2;
}

.unread{
    min-width:18px;
    height:18px;

    padding:0 5px;

    border-radius:999px;

    display:grid;
    place-items:center;

    background:
        linear-gradient(
            135deg,
            #6e5bff,
            #8d7cff
        );

    color:white;

    font-size:8px;
    font-weight:850;

    box-shadow:
        0 5px 20px rgba(110,91,255,.3);
}

/* =========================
   MAIN
========================= */

.main{
    flex:1;

    min-width:0;

    display:flex;
    flex-direction:column;

    border:
        1px solid var(--border);

    border-radius:24px;

    overflow:hidden;

    background:
        radial-gradient(
            circle at 50% 40%,
            rgba(61,47,209,.06),
            transparent 40%
        ),
        #0d0920;

    box-shadow:
        0 25px 100px rgba(0,0,0,.25);

    position:relative;
}

/* =========================
   CHAT HEADER
========================= */

.chat-header{
    height:75px;

    padding:0 22px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    background:
        rgba(19,14,44,.72);

    border-bottom:
        1px solid rgba(163,139,255,.08);

    backdrop-filter:blur(24px);

    z-index:3;
}

.profile{
    display:flex;
    align-items:center;

    gap:12px;
}

.profile-avatar{
    width:42px;
    height:42px;

    border-radius:50%;

    display:grid;
    place-items:center;

    background:
        linear-gradient(
            135deg,
            #4032d5,
            #a38bff
        );

    font-size:10px;
    font-weight:850;

    position:relative;
}

.profile-name{
    font-size:12px;
    font-weight:800;
}

.profile-status{
    margin-top:4px;

    color:#61dca8;

    font-size:8.5px;
}

.profile-status.typing{
    color:var(--lavender);
}

.chat-actions{
    display:flex;
    gap:7px;
}

/* =========================
   MESSAGES AREA
========================= */

.messages{
    flex:1;

    overflow-y:auto;

    padding:
        32px
        clamp(25px,8vw,125px)
        30px;

    display:flex;
    flex-direction:column;

    gap:3px;

    background-image:
        radial-gradient(
            rgba(163,139,255,.025) 1px,
            transparent 1px
        );

    background-size:25px 25px;
}

.messages::-webkit-scrollbar{
    width:4px;
}

.messages::-webkit-scrollbar-thumb{
    background:#221b40;
    border-radius:20px;
}

/* Date */

.date{
    align-self:center;

    padding:7px 13px;

    border-radius:999px;

    background:
        rgba(26,22,51,.85);

    border:
        1px solid rgba(163,139,255,.08);

    color:#77708f;

    font-size:8px;
    font-weight:750;

    letter-spacing:.7px;

    margin-bottom:15px;
}

/* =========================
   MESSAGE ROW
========================= */

.message-row{
    display:flex;

    width:100%;

    margin-bottom:2px;
}

.message-row.sent{
    justify-content:flex-end;
}

.message-row.received{
    justify-content:flex-start;
}

.message{
    max-width:
        min(560px,70%);

    padding:
        9px 12px
        7px;

    font-size:10.5px;

    line-height:1.55;

    color:#e9e6f6;

    position:relative;
}

/* Incoming */

.received .message{
    background:
        linear-gradient(
            135deg,
            rgba(33,27,60,.95),
            rgba(29,24,52,.95)
        );

    border:
        1px solid rgba(163,139,255,.055);

    border-radius:
        5px 15px 15px 15px;
}

/* Outgoing */

.sent .message{
    background:
        linear-gradient(
            135deg,
            #3d2fd1,
            #5040e2
        );

    border-radius:
        15px 5px 15px 15px;

    box-shadow:
        0 8px 30px rgba(61,47,209,.13);
}

/* Message metadata */

.meta{
    float:right;

    display:flex;
    align-items:center;

    gap:4px;

    margin-left:15px;
    margin-top:6px;

    font-size:7.5px;

    color:
        rgba(242,240,255,.43);
}

.checks{
    color:#b7aaff;

    font-size:9px;

    letter-spacing:-2px;
}

/* =========================
   TYPING AREA
========================= */

.composer{
    min-height:78px;

    padding:
        14px 21px;

    display:flex;
    align-items:center;

    gap:8px;

    background:
        rgba(19,14,44,.82);

    border-top:
        1px solid rgba(163,139,255,.08);

    backdrop-filter:blur(25px);

    position:relative;
}

.attach{
    width:41px;
    height:41px;

    flex-shrink:0;

    border:
        1px solid rgba(163,139,255,.07);

    border-radius:12px;

    background:
        rgba(255,255,255,.025);

    color:#958ea9;

    font-size:18px;

    cursor:pointer;

    transition:.2s;
}

.attach:hover{
    color:white;

    background:
        rgba(110,91,255,.1);
}

.input-box{
    flex:1;

    height:43px;

    padding:
        0 13px;

    display:flex;
    align-items:center;

    gap:9px;

    border-radius:13px;

    background:
        rgba(255,255,255,.03);

    border:
        1px solid rgba(163,139,255,.08);

    transition:.2s;
}

.input-box:focus-within{
    border-color:
        rgba(110,91,255,.35);

    box-shadow:
        0 0 0 3px rgba(110,91,255,.045);
}

.input-box input{
    flex:1;

    border:0;
    outline:0;

    background:transparent;

    color:white;

    font-size:10.5px;
}

.input-box input::placeholder{
    color:#706985;
}

.emoji{
    border:0;

    background:transparent;

    color:#89829f;

    cursor:pointer;

    font-size:15px;
}

.send{
    width:43px;
    height:43px;

    flex-shrink:0;

    border:0;

    border-radius:13px;

    background:
        linear-gradient(
            135deg,
            #3d2fd1,
            #6e5bff
        );

    color:white;

    font-size:14px;

    cursor:pointer;

    box-shadow:
        0 9px 30px rgba(110,91,255,.25);

    transition:
        transform .2s,
        box-shadow .2s;
}

.send:hover{
    transform:
        translateY(-2px);

    box-shadow:
        0 14px 40px rgba(110,91,255,.4);
}

/* =========================
   ATTACHMENT MENU
========================= */

.attach-menu{
    position:absolute;

    bottom:76px;
    left:20px;

    width:190px;

    padding:8px;

    background:
        rgba(26,22,51,.96);

    border:
        1px solid rgba(163,139,255,.13);

    border-radius:16px;

    box-shadow:
        0 25px 80px rgba(0,0,0,.45);

    backdrop-filter:blur(25px);

    display:none;

    z-index:20;
}

.attach-menu.show{
    display:block;

    animation:
        menuIn .18s ease;
}

@keyframes menuIn{
    from{
        opacity:0;
        transform:translateY(8px) scale(.98);
    }

    to{
        opacity:1;
        transform:none;
    }
}

.attach-item{
    width:100%;

    padding:10px;

    border:0;

    background:transparent;

    color:#a39cb7;

    border-radius:9px;

    text-align:left;

    font-size:9.5px;

    cursor:pointer;
}

.attach-item:hover{
    color:white;

    background:
        rgba(110,91,255,.09);
}

/* =========================
   MOBILE
========================= */

.mobile-back{
    display:none;
}

@media(max-width:900px){

    .app{
        padding:10px;
        gap:10px;
    }

    .sidebar{
        width:330px;
        min-width:330px;
    }

    .messages{
        padding-left:30px;
        padding-right:30px;
    }

}

@media(max-width:700px){

    .app{
        padding:0;
    }

    .sidebar{
        width:100%;
        min-width:100%;

        border-radius:0;
        border:0;
    }

    .main{
        display:none;

        width:100%;

        border-radius:0;
        border:0;
    }

    .sidebar.mobile-hidden{
        display:none;
    }

    .main.mobile-visible{
        display:flex;
    }

    .sidebar-header{
        height:68px;
    }

    .chat-header{
        height:68px;
        padding:0 14px;
    }

    .mobile-back{
        display:grid;
        margin-right:2px;
    }

    .messages{
        padding:
            25px 14px;
    }

    .message{
        max-width:83%;
    }

    .composer{
        min-height:70px;
        padding:10px 11px;
    }

    .attach{
        width:38px;
        height:38px;
    }

    .send{
        width:40px;
        height:40px;
    }
}
</style>
</head>

<body>

<div class="app">

<!-- =========================
