<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Behind The Mark — Brand Story</title>

<!-- Premium Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">

<style>

:root{
    --midnight:#1A1633;
    --deep:#130e2c;
    --surface:#0d0920;
    --indigo:#3D2FD1;
    --primary:#6E5BFF;
    --lavender:#A38BFF;
    --light:#F2F0FF;

    --glass:rgba(255,255,255,.055);
    --glass-border:rgba(255,255,255,.10);

    --muted:rgba(242,240,255,.55);
    --soft:rgba(242,240,255,.32);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
        radial-gradient(
            circle at 50% -10%,
            rgba(110,91,255,.18),
            transparent 35%
        ),
        var(--surface);

    color:var(--light);

    font-family:'DM Sans',sans-serif;

    overflow-x:hidden;
}

/* =========================================
   GLOBAL AMBIENCE
========================================= */

body::before{
    content:"";
    position:fixed;
    inset:0;

    background:
        radial-gradient(
            circle at 15% 25%,
            rgba(61,47,209,.13),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 65%,
            rgba(163,139,255,.09),
            transparent 28%
        );

    pointer-events:none;
    z-index:-3;
}

body::after{
    content:"";

    position:fixed;
    inset:0;

    background-image:
        linear-gradient(
            rgba(255,255,255,.018) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.018) 1px,
            transparent 1px
        );

    background-size:70px 70px;

    mask-image:
        linear-gradient(
            to bottom,
            black 0%,
            transparent 85%
        );

    pointer-events:none;
    z-index:-2;
}

/* =========================================
   AMBIENT ORBS
========================================= */

.ambient{
    position:fixed;
    width:420px;
    height:420px;

    border-radius:50%;

    filter:blur(100px);

    opacity:.12;

    pointer-events:none;

    z-index:-1;
}

.ambient.one{
    background:var(--primary);
    top:-180px;
    left:-180px;
}

.ambient.two{
    background:var(--lavender);
    right:-220px;
    top:35%;
}

.ambient.three{
    background:var(--indigo);
    bottom:-220px;
    left:30%;
}

/* =========================================
   ENTRY
========================================= */

.entry{
    position:fixed;
    inset:0;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        radial-gradient(
            circle at center,
            #1a1633 0%,
            #0d0920 55%,
            #080611 100%
        );

    z-index:9999;

    transition:
        opacity 1.2s cubic-bezier(.16,1,.3,1),
        visibility 1.2s ease;
}

.entry.hide{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
}

.entry-content{
    text-align:center;
}

.entry-eyebrow{
    margin-bottom:28px;

    font-size:9px;
    letter-spacing:5px;

    color:rgba(242,240,255,.38);

    opacity:0;
    animation:entryFade 1s ease .3s forwards;
}

.entry-logo{
    width:min(210px,48vw);

    opacity:0;

    transform:
        translateY(20px)
        scale(.82);

    filter:
        blur(14px)
        drop-shadow(
            0 0 50px
            rgba(110,91,255,.25)
        );

    animation:
        logoEnter
        1.6s
        cubic-bezier(.16,1,.3,1)
        .45s
        forwards;
}

.entry-line{
    width:0;
    height:1px;

    margin:32px auto 18px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--lavender),
            transparent
        );

    animation:
        lineEnter
        1.1s
        ease
        1.35s
        forwards;
}

.entry-subtitle{
    font-size:9px;
    letter-spacing:4px;

    color:rgba(242,240,255,.35);

    opacity:0;

    animation:
        entryFade
        1s
        ease
        1.5s
        forwards;
}

@keyframes logoEnter{

    to{
        opacity:1;

        transform:
            translateY(0)
            scale(1);

        filter:
            blur(0)
            drop-shadow(
                0 0 70px
                rgba(110,91,255,.20)
            );
    }
}

@keyframes lineEnter{

    to{
        width:100px;
    }
}

@keyframes entryFade{

    to{
        opacity:1;
    }
}

/* =========================================
   NAVIGATION
========================================= */

.nav{
    position:fixed;

    top:20px;
    left:50%;

    transform:translateX(-50%);

    width:min(94%,1300px);

    padding:13px 17px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    background:
        rgba(13,9,32,.48);

    border:
        1px solid rgba(255,255,255,.08);

    border-radius:18px;

    backdrop-filter:
        blur(24px)
        saturate(150%);

    -webkit-backdrop-filter:
        blur(24px)
        saturate(150%);

    box-shadow:
        0 20px 70px rgba(0,0,0,.22);

    z-index:100;
}

.nav-brand{
    display:flex;
    align-items:center;
    gap:10px;

    font-family:'Manrope',sans-serif;

    font-size:10px;
    font-weight:800;

    letter-spacing:3px;
}

.nav-dot{
    width:6px;
    height:6px;

    border-radius:50%;

    background:var(--primary);

    box-shadow:
        0 0 15px
        rgba(110,91,255,.9);
}

.nav-status{
    font-size:9px;
    letter-spacing:2px;

    color:var(--soft);
}

/* =========================================
   SECTIONS
========================================= */

section{
    position:relative;

    min-height:100vh;

    padding:
        150px 7vw;

    display:flex;
    align-items:center;

    overflow:hidden;
}

.container{
    width:100%;
    max-width:1380px;
    margin:auto;
}

.eyebrow{
    font-family:'Manrope',sans-serif;

    font-size:9px;
    font-weight:700;

    letter-spacing:5px;

    text-transform:uppercase;

    color:
        rgba(163,139,255,.72);

    margin-bottom:28px;
}

h1,
h2,
h3{
    font-family:'Manrope',sans-serif;
}

h1{
    font-size:
        clamp(55px,9vw,145px);

    line-height:.87;

    letter-spacing:-.075em;

    font-weight:800;
}

h2{
    font-size:
        clamp(43px,6.5vw,92px);

    line-height:.94;

    letter-spacing:-.065em;

    font-weight:700;
}

.serif{
    font-family:'Playfair Display',serif;

    font-style:italic;

    font-weight:500;

    letter-spacing:-.04em;

    color:
        rgba(242,240,255,.78);
}

.description{
    max-width:590px;

    margin-top:36px;

    color:var(--muted);

    font-size:
        clamp(14px,1.2vw,17px);

    line-height:1.95;
}

/* =========================================
   GLASS CARD
========================================= */

.glass{
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.075),
            rgba(255,255,255,.025)
        );

    border:
        1px solid
        var(--glass-border);

    box-shadow:
        inset 0 1px 0
        rgba(255,255,255,.045),

        0 35px 100px
        rgba(0,0,0,.25);

    backdrop-filter:
        blur(30px)
        saturate(140%);

    -webkit-backdrop-filter:
        blur(30px)
        saturate(140%);
}

/* =========================================
   SCROLL REVEAL
========================================= */

.reveal{
    opacity:0;

    transform:
        translateY(70px)
        scale(.985);

    filter:blur(5px);

    transition:
        opacity 1.1s cubic-bezier(.16,1,.3,1),
        transform 1.15s cubic-bezier(.16,1,.3,1),
        filter 1.1s ease;
}

.reveal.active{
    opacity:1;

    transform:
        translateY(0)
        scale(1);

    filter:blur(0);
}

/* =========================================
   HERO
========================================= */

.hero{
    min-height:100svh;

    text-align:center;

    justify-content:center;
}

.hero-content{
    display:flex;
    flex-direction:column;

    align-items:center;
}

.hero-title{
    max-width:1100px;
}

.hero-logo-wrap{
    position:relative;

    margin:
        65px
        auto
        20px;

    width:min(330px,65vw);
}

.hero-logo-glow{
    position:absolute;

    inset:15%;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(110,91,255,.30),
            transparent 65%
        );

    filter:blur(40px);
}

.hero-logo{
    position:relative;

    width:100%;

    display:block;

    filter:
        drop-shadow(
            0 30px 80px
            rgba(110,91,255,.18)
        );
}

.hero-description{
    text-align:center;
}

.scroll-indicator{
    position:absolute;

    bottom:35px;
    left:50%;

    transform:translateX(-50%);

    color:var(--soft);

    font-size:8px;
    letter-spacing:4px;

    text-align:center;
}

.scroll-indicator span{
    display:block;

    width:1px;
    height:50px;

    margin:14px auto 0;

    background:
        linear-gradient(
            to bottom,
            var(--lavender),
            transparent
        );

    animation:
        scrollPulse
        1.8s
        ease-in-out
        infinite;
}

@keyframes scrollPulse{

    0%,
    100%{
        opacity:.25;
        transform:scaleY(.45);
        transform-origin:top;
    }

    50%{
        opacity:1;
        transform:scaleY(1);
    }
}

/* =========================================
   STORY
========================================= */

.story{
    border-top:
        1px solid
        rgba(255,255,255,.055);
}

.story-grid{
    display:grid;

    grid-template-columns:
        .7fr 1.3fr;

    gap:9vw;

    align-items:center;
}

.story-number{
    font-family:'Manrope',sans-serif;

    font-size:
        clamp(130px,20vw,320px);

    line-height:.7;

    font-weight:800;

    letter-spacing:-.12em;

    color:
        rgba(163,139,255,.055);

    user-select:none;
}

/* =========================================
   LOGO SHOWCASE
========================================= */

.logo-showcase{
    min-height:110vh;

    text-align:center;

    justify-content:center;
}

.logo-stage{
    position:relative;

    width:min(850px,100%);

    min-height:580px;

    margin:70px auto 0;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:42px;

    overflow:hidden;
}

.logo-stage::before{
    content:"";

    position:absolute;

    width:500px;
    height:500px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(110,91,255,.23),
            transparent 68%
        );

    filter:blur(35px);
}

.logo-stage::after{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            120deg,
            transparent 30%,
            rgba(255,255,255,.035),
            transparent 70%
        );

    transform:
        translateX(-100%);

    animation:
        glassSweep
        7s
        ease-in-out
        infinite;
}

@keyframes glassSweep{

    0%{
        transform:translateX(-100%);
    }

    45%,
    100%{
        transform:translateX(100%);
    }
}

.logo-stage img{
    position:relative;

    z-index:2;

    width:min(430px,68%);

    filter:
        drop-shadow(
            0 40px 100px
            rgba(110,91,255,.25)
        );

    transition:
        transform .7s
        cubic-bezier(.16,1,.3,1);
}

.logo-stage:hover img{
    transform:
        scale(1.035)
        translateY(-5px);
}

/* =========================================
   CONSTRUCTION
========================================= */

.construction-box{
    position:relative;

    margin-top:65px;

    min-height:560px;

    border-radius:38px;

    overflow:hidden;

    display:flex;

    align-items:center;

    justify-content:center;
}

.construction-grid{
    position:absolute;
    inset:0;

    opacity:.55;

    background-image:
        linear-gradient(
            rgba(163,139,255,.07) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(163,139,255,.07) 1px,
            transparent 1px
        );

    background-size:80px 80px;

    mask-image:
        radial-gradient(
            circle at center,
            black 10%,
            transparent 72%
        );
}

.center-line{
    position:absolute;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(163,139,255,.35),
            transparent
        );
}

.center-line.horizontal{
    width:100%;
    height:1px;
}

.center-line.vertical{
    height:100%;
    width:1px;
}

.construction-logo{
    position:relative;

    z-index:3;

    width:min(400px,60%);

    filter:
        drop-shadow(
            0 30px 80px
            rgba(110,91,255,.25)
        );
}

.measurement{
    position:absolute;

    font-size:8px;

    letter-spacing:3px;

    color:
        rgba(242,240,255,.28);
}

.measurement.top{
    top:24px;
    right:28px;
}

.measurement.bottom{
    bottom:24px;
    left:28px;
}

/* =========================================
   COLOR SYSTEM
========================================= */

.color-section{
    min-height:100vh;
}

.color-grid{
    display:grid;

    grid-template-columns:
        repeat(2,1fr);

    gap:18px;

    margin-top:65px;
}

.color-card{
    position:relative;

    min-height:300px;

    padding:32px;

    border-radius:28px;

    overflow:hidden;

    display:flex;

    align-items:flex-end;

    border:
        1px solid
        rgba(255,255,255,.08);

    background:
        rgba(255,255,255,.025);
}

.color-card::before{
    content:"";

    position:absolute;

    width:260px;
    height:260px;

    top:-100px;
    right:-80px;

    border-radius:50%;

    background:
        var(--color);

    opacity:.22;

    filter:blur(60px);
}

.color-card::after{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            to top,
            rgba(13,9,32,.88),
            transparent 70%
        );
}

.color-info{
    position:relative;

    z-index:2;
}

.color-name{
    font-family:'Manrope',sans-serif;

    font-size:18px;

    font-weight:700;

    margin-bottom:8px;
}

.color-code{
    font-size:9px;

    letter-spacing:3px;

    color:var(--soft);
}

/* =========================================
   MANIFESTO
========================================= */

.manifesto{
    min-height:120vh;

    text-align:center;

    justify-content:center;
}

.manifesto-inner{
    max-width:1150px;
    margin:auto;
}

.manifesto-text{
    font-family:'Manrope',sans-serif;

    font-size:
        clamp(43px,7vw,105px);

    line-height:1.03;

    letter-spacing:-.07em;

    font-weight:700;
}

.manifesto-text .dim{
    color:
        rgba(242,240,255,.20);

    transition:
        color 1s ease;
}

.manifesto.active-section
.manifesto-text .dim{
    color:
        rgba(242,240,255,.72);
}

/* =========================================
   FINAL
========================================= */

.final{
    min-height:100svh;

    text-align:center;

    justify-content:center;

    border-top:
        1px solid
        rgba(255,255,255,.055);
}

.final-logo{
    width:min(260px,55vw);

    margin:
        60px auto;

    display:block;

    filter:
        drop-shadow(
            0 35px 90px
            rgba(110,91,255,.25)
        );
}

.final h2{
    max-width:900px;
    margin:auto;
}

.cta{
    display:inline-flex;

    margin-top:48px;

    padding:
        17px 28px;

    border-radius:999px;

    color:var(--light);

    text-decoration:none;

    font-family:'Manrope',sans-serif;

    font-size:9px;

    font-weight:700;

    letter-spacing:3px;

    background:
        linear-gradient(
            135deg,
            rgba(110,91,255,.25),
            rgba(61,47,209,.18)
        );

    border:
        1px solid
        rgba(163,139,255,.25);

    box-shadow:
        0 15px 50px
        rgba(61,47,209,.18);

    backdrop-filter:blur(20px);

    transition:
        transform .4s ease,
        box-shadow .4s ease,
        border-color .4s ease;
}

.cta:hover{
    transform:translateY(-5px);

    border-color:
        rgba(163,139,255,.55);

    box-shadow:
        0 25px 70px
        rgba(61,47,209,.3);
}

/* =========================================
   FOOTER
========================================= */

footer{
    padding:28px;

    text-align:center;

    color:
        rgba(242,240,255,.18);

    font-size:8px;

    letter-spacing:4px;
}

/* =========================================
   RESPONSIVE
========================================= */

@media(max-width:760px){

    section{
        min-height:100svh;

        padding:
            125px 6vw;
    }

    .nav{
        top:12px;
        padding:12px 14px;
    }

    .nav-brand{
        font-size:8px;
        letter-spacing:2px;
    }

    .nav-status{
        font-size:7px;
    }

    h1{
        font-size:
            clamp(48px,15vw,85px);
    }

    h2{
        font-size:
            clamp(40px,12vw,70px);
    }

    .description{
        font-size:14px;
        line-height:1.85;
    }

    .story-grid{
        grid-template-columns:1fr;
        gap:50px;
    }

    .story-number{
        font-size:130px;
    }

    .logo-stage{
        min-height:430px;

        border-radius:28px;
    }

    .logo-stage img{
        width:75%;
    }

    .construction-box{
        min-height:430px;

        border-radius:28px;
    }

    .construction-logo{
        width:75%;
    }

    .color-grid{
        grid-template-columns:1fr;
    }

    .color-card{
        min-height:230px;
    }

    .manifesto-text{
        font-size:
            clamp(42px,12vw,68px);
    }

    .final-logo{
        width:55vw;
    }
}

/* =========================================
   REDUCED MOTION
========================================= */

@media(prefers-reduced-motion:reduce){

    html{
        scroll-behavior:auto;
    }

    *,
    *::before,
    *::after{
        animation:none !important;
        transition:none !important;
    }

    .reveal{
        opacity:1;
        transform:none;
        filter:none;
    }
}

</style>
</head>

