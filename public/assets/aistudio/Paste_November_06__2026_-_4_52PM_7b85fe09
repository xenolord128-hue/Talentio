<script>

/* =========================================
   ENTRY
========================================= */

window.addEventListener("load", () => {

    setTimeout(() => {

        document
            .getElementById("entry")
            .classList.add("hide");

    }, 2700);

});


/* =========================================
   SCROLL REVEAL
========================================= */

const revealElements =
    document.querySelectorAll(".reveal");

const revealObserver =
    new IntersectionObserver(

        (entries) => {

            entries.forEach((entry) => {

                if(entry.isIntersecting){

                    entry.target
                        .classList
                        .add("active");

                }else{

                    /*
                     * Remove the class when the element
                     * leaves the viewport.
                     *
                     * This creates the requested
                     * scroll-in + scroll-out animation.
                     */

                    entry.target
                        .classList
                        .remove("active");

                }

            });

        },

        {
            threshold:0.14,
            rootMargin:"0px 0px -80px 0px"
        }

    );


revealElements.forEach(element => {

    revealObserver.observe(element);

});


/* =========================================
   MANIFESTO ACTIVE STATE
========================================= */

const manifesto =
    document.querySelector(".manifesto");

const manifestoObserver =
    new IntersectionObserver(

        (entries) => {

            entries.forEach(entry => {

                if(entry.isIntersecting){

                    manifesto
                        .classList
                        .add("active-section");

                }else{

                    manifesto
                        .classList
                        .remove("active-section");

                }

            });

        },

        {
            threshold:.45
        }

    );

manifestoObserver.observe(manifesto);


/* =========================================
   NAV STATUS
========================================= */

const sections =
    document.querySelectorAll("section");

const navStatus =
    document.querySelector(".nav-status");

const sectionObserver =
    new IntersectionObserver(

        (entries) => {

            entries.forEach(entry => {

                if(entry.isIntersecting){

                    const index =
                        [...sections]
                        .indexOf(entry.target) + 1;

                    navStatus.textContent =
                        String(index)
                        .padStart(2,"0")
                        +
                        " — "
                        +
                        String(sections.length)
                        .padStart(2,"0");

                }

            });

        },

        {
            threshold:.5
        }

    );


sections.forEach(section => {

    sectionObserver.observe(section);

});


/* =========================================
   MOUSE PARALLAX
========================================= */

if(
    window.matchMedia(
        "(pointer:fine)"
    ).matches
){

    document.addEventListener(
        "mousemove",
        (e) => {

            const x =
                (e.clientX / window.innerWidth - .5);

            const y =
                (e.clientY / window.innerHeight - .5);

            document
                .querySelectorAll(
                    ".ambient"
                )
                .forEach((orb,index) => {

                    const strength =
                        (index + 1) * 10;

                    orb.style.transform =
                        `translate(
                            ${x * strength}px,
                            ${y * strength}px
                        )`;

                });

        }
    );

}


/* =========================================
   PREVENT IMAGE DRAG
========================================= */

document
    .querySelectorAll("img")
    .forEach(img => {

        img.setAttribute(
            "draggable",
            "false"
        );

    });

</script>

