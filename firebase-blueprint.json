{
  "entities": {
    "User": {
      "title": "User",
      "description": "Talentio user and freelancer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "userType": { "type": "string", "enum": ["client", "freelancer", "agency"] },
        "accountStatus": { "type": "string", "enum": ["approved", "pending", "suspended"] },
        "isApprovedSeller": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "skills": { "type": "array" },
        "balanceAvailable": { "type": "number" },
        "balanceInEscrow": { "type": "number" }
      },
      "required": ["id", "email", "userType"]
    },
    "Gig": {
      "title": "Gig",
      "description": "Marketplace service gig offered by freelancers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "freelancerId": { "type": "string" },
        "freelancerName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "startingPrice": { "type": "number" },
        "deliveryDays": { "type": "number" },
        "rating": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "freelancerId", "title", "startingPrice"]
    },
    "Job": {
      "title": "Job",
      "description": "Project job posted by client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "category": { "type": "string" },
        "clientId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "budget"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Proposal submitted by a freelancer on a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "freelancerId": { "type": "string" },
        "bidAmount": { "type": "number" },
        "coverLetter": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "jobId", "freelancerId", "bidAmount"]
    },
    "Order": {
      "title": "Order",
      "description": "Escrow contract order between client and freelancer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "gigId": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "escrowFunded": { "type": "boolean" }
      },
      "required": ["id", "totalAmount", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat conversation between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array" },
        "participants": { "type": "object" },
        "lastMessage": { "type": "object" },
        "unreadCounts": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message in conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "receiverId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for messages and orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "senderId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "Report": {
      "title": "Report",
      "description": "Abuse or message report for moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetId", "reason"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Governance audit trail log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "action"]
    },
    "Notice": {
      "title": "Notice",
      "description": "System, administrative, ranking, and account notices for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetUserId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["approval", "rank", "system", "gig", "order", "announcement"] },
        "priority": { "type": "string", "enum": ["high", "normal", "low"] },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "actionUrl": { "type": "string" }
      },
      "required": ["id", "title", "description", "category"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Web push subscription details for authenticated user devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "endpoint": { "type": "string" },
        "keys": { "type": "object" },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "endpoint", "keys"]
    }
  },
  "firestore": {
    "/push_subscriptions/{subId}": {
      "schema": "PushSubscription",
      "description": "Web push notification subscriptions for user devices"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and public freelancer profiles"
    },
    "/gigs/{gigId}": {
      "schema": "Gig",
      "description": "Marketplace gig listings"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Open project listings"
    },
    "/proposals/{proposalId}": {
      "schema": "Proposal",
      "description": "Freelancer bids on projects"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Escrow contracts and milestone orders"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations between users"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside direct chat conversations"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time user push and in-app notifications"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User moderation reports"
    },
    "/adminLogs/{logId}": {
      "schema": "AdminLog",
      "description": "Audit records for administrative compliance actions"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Administrative announcements and user notices"
    }
  }
}
