rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // HELPER GUARDS & ACCESS CONTROL PRIMITIVES
    // ========================================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict Custom Claim verification for administrative operations
    function hasAdminClaim() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        ((request.auth.token.email == 'lord79915@gmail.com' || request.auth.token.email == 'xenolord128@gmail.com') && request.auth.token.email_verified == true)
      );
    }

    function isAdmin() {
      return hasAdminClaim();
    }

    function isClient(userId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(userId)).data.role == 'CLIENT' ||
        get(/databases/$(database)/documents/users/$(userId)).data.userType == 'client'
      );
    }

    function isFreelancer(userId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(userId)).data.role == 'FREELANCER' ||
        get(/databases/$(database)/documents/users/$(userId)).data.userType == 'freelancer'
      );
    }

    // ========================================================================
    // 1. ADMIN & ADMINS COLLECTIONS (STRICT CUSTOM CLAIM ACCESS ONLY)
    // ========================================================================
    match /admin/{document=**} {
      allow read, write: if hasAdminClaim();
    }

    match /admins/{adminId} {
      allow read, write: if hasAdminClaim();
    }

    // ========================================================================
    // 2. USERS & TALENT PROFILES (RBAC & CLAIM PROTECTED)
    // ========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only owner can create, but cannot grant themselves ADMIN role unless possessing admin claim
      allow create: if isSignedIn() && isOwner(userId) && (
        (request.resource.data.role != 'ADMIN' && request.resource.data.role != 'admin') ||
        hasAdminClaim()
      );
      // Owner can update their profile information, but CANNOT modify role, accountStatus, or subscriptionStatus
      allow update: if isSignedIn() && (
        (isOwner(userId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus', 'subscriptionStatus', 'subscriptionEndDate', 'platformFeePercent'])) ||
        hasAdminClaim()
      );
      allow delete: if hasAdminClaim();
    }

    // ========================================================================
    // 3. GIGS & MARKETPLACE SERVICES (FREELANCER ONLY FOR CREATION)
    // ========================================================================
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        (request.resource.data.freelancerId == request.auth.uid && !isClient(request.auth.uid)) ||
        hasAdminClaim()
      );
      allow update: if isSignedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        request.resource.data.freelancerId == request.auth.uid ||
        hasAdminClaim()
      );
      allow delete: if isSignedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        hasAdminClaim()
      );
    }

    // ========================================================================
    // 4. PLATFORM SETTINGS (ADMIN CUSTOM CLAIM REQUIRED FOR MODIFICATIONS)
    // ========================================================================
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if hasAdminClaim();
    }

    // ========================================================================
    // 5. JOBS & CLIENT PROJECTS
    // ========================================================================
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        request.resource.data.clientId == request.auth.uid ||
        hasAdminClaim()
      );
      allow delete: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        hasAdminClaim()
      );
    }

    // ========================================================================
    // 6. PROPOSALS
    // ========================================================================
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        hasAdminClaim()
      );
      allow delete: if isSignedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        hasAdminClaim()
      );
    }

    // ========================================================================
    // 7. ORDERS & ESCROW CONTRACTS
    // ========================================================================
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if hasAdminClaim();
    }

    // ========================================================================
    // 8. CHAT CONVERSATIONS & TIMELINE MESSAGES
    // ========================================================================
    match /conversations/{conversationId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ========================================================================
    // 9. REAL-TIME NOTIFICATIONS & WEB PUSH SUBSCRIPTIONS
    // ========================================================================
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    // ========================================================================
    // 10. PRESENCE & TYPING INDICATORS
    // ========================================================================
    match /presence/{userId} {
      allow read, write: if true;
    }

    match /typing/{convId} {
      allow read, write: if true;
    }

    // ========================================================================
    // 11. MODERATION & ABUSE REPORTS (ADMIN CUSTOM CLAIM FOR REVIEW/DELETE)
    // ========================================================================
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && hasAdminClaim();
    }

    // ========================================================================
    // 12. NOTICES & PLATFORM ANNOUNCEMENTS (ADMIN CUSTOM CLAIM FOR PUBLISHING)
    // ========================================================================
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if hasAdminClaim();
    }

    // ========================================================================
    // 13. ADMINISTRATIVE AUDIT TRAIL LOGS (ADMIN CUSTOM CLAIM REQUIRED)
    // ========================================================================
    match /adminLogs/{logId} {
      allow read: if hasAdminClaim();
      allow create: if hasAdminClaim();
      allow update, delete: if false;
    }

    // ========================================================================
    // 14. HEALTH CHECK / CONNECTION TEST
    // ========================================================================
    match /test/{docId} {
      allow read, write: if true;
    }

    // ========================================================================
    // 15. DEFAULT DENY
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
