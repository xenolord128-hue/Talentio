rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile avatars
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // Gig images and gallery
    match /gigs/{gigId}/images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Chat voice notes & audio files
    match /chat/{conversationId}/voice/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Chat attachments and project documents
    match /chat/{conversationId}/attachments/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
